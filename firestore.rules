rules_version = '2';
// CampIL security rules. Tested by tests/rules/*.test.ts against the Firestore emulator (GitHub Actions).
//
// trips/{tripId}                    the shared trip: plan, shared gear, menu, schedule, members, invite keys
// trips/{tripId}/families/{famId}   one family's private gear — readable/writable only by that family's members
// trips/{tripId}/journal/{entryId}  journal entries and album photos — members only
//
// Roles: owner (organiser) · member (joined; optionally bound to one family) · pending (asked to join a closed trip).
// Joining needs the current invite key from the link; removing someone rotates that key, so old links stop working.
// The organiser may also set an expiry (invite.until) after which links no longer admit new people.
// users/{uid}  a person's private index of their shared trips (only they can read/write it).
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      function uid() { return request.auth.uid; }
      function signedIn() { return request.auth != null; }
      function isOwner() { return signedIn() && resource.data.owner == uid(); }
      function isMember() { return signedIn() && uid() in resource.data.members; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function mapDiff(f) { return request.resource.data.get(f, {}).diff(resource.data.get(f, {})).affectedKeys(); }
      function onlyMine(f) { return mapDiff(f).hasOnly([uid()]); }
      function newMe() { return request.resource.data.members[uid()]; }
      function oldMe() { return resource.data.members[uid()]; }
      function myFam() { return resource.data.members[uid()].get('familyId', null); }
      // invite key for the family (or the whole trip) the joiner claims
      function keyFor(fam) { return fam == null ? resource.data.get('invite', {}).get('all', '') : resource.data.get('invite', {}).get('fam', {}).get(fam, ''); }
      function validKey(m) { return m.get('k', '') is string && m.get('k', '') != '' && m.get('k', '') == keyFor(m.get('familyId', null)); }
      // optional expiry set by the organiser (ms since epoch); links stop admitting new people after it
      function notExpired() { return !('until' in resource.data.get('invite', {})) || request.time.toMillis() < resource.data.invite.until; }

      // A new member adds only their own entry, as an editor, with the current key of the family they join.
      function joinsWithKey() {
        return signedIn() && !isMember() && resource.data.get('access', 'link') == 'link'
          && changed().hasOnly(['members', 'updatedAt']) && onlyMine('members')
          && newMe().get('role', '') == 'editor' && validKey(newMe()) && notExpired();
      }
      // A member updates their own entry (name, last seen…) but can't change their family, role or key.
      function ownEntryOk() {
        return !mapDiff('members').hasAny([uid()]) || (
          uid() in request.resource.data.members
          && newMe().get('familyId', null) == oldMe().get('familyId', null)
          && newMe().get('role', '') == oldMe().get('role', '')
          && newMe().get('k', '') == oldMe().get('k', ''));
      }
      // Members edit the plan, shared gear, menu, schedule and their own family's progress — not access settings.
      function memberEdit() {
        return isMember()
          && !changed().hasAny(['owner', 'access', 'pending', 'invite', 'createdAt'])
          && (!changed().hasAny(['members']) || (onlyMine('members') && ownEntryOk()))
          && (!changed().hasAny(['progress']) || (myFam() != null && mapDiff('progress').hasOnly([myFam()])));
      }
      // The organiser manages everyone's family — except their own once set, so they can't move into another family to read it.
      function ownerEdit() {
        return isOwner() && (!mapDiff('members').hasAny([uid()]) || oldMe().get('familyId', null) == null
          || (uid() in request.resource.data.members && newMe().get('familyId', null) == oldMe().get('familyId', null)));
      }
      // Closed trips: a Google-signed-in person leaves a request (their own entry only).
      function requestsToJoin() {
        return signedIn() && !isMember() && request.auth.token.email is string
          && changed().hasOnly(['pending', 'updatedAt']) && onlyMine('pending');
      }

      allow get: if isOwner() || isMember();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.owner == uid() && request.resource.data.members.keys().hasOnly([uid()]);
      allow delete: if isOwner();
      allow update: if ownerEdit() || memberEdit() || joinsWithKey() || requestsToJoin();

      match /families/{famId} {
        function trip() { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
        function inFamily() { return request.auth != null && request.auth.uid in trip().members && trip().members[request.auth.uid].get('familyId', null) == famId; }
        allow read, update, delete: if inFamily();
        // the organiser seeds a family's starting list once (it can't read it back afterwards)
        allow create: if inFamily() || (request.auth != null && trip().owner == request.auth.uid);
      }

      match /journal/{entryId} {
        function trip2() { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
        allow read, write: if request.auth != null && (trip2().owner == request.auth.uid || request.auth.uid in trip2().members);
      }
    }

    // users/{uid}: a person's own list of shared trips (ids and names only), so their other devices can find them.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
